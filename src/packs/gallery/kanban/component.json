{
  "id": "gallery/kanban",
  "apiVersion": 1,
  "version": "1.2.0",
  "name": { "zh": "看板", "en": "Board" },
  "description": { "zh": "表格的视图：按一列把每一行分组成卡片，拖动卡片就改了那一格", "en": "A view of a table: its rows as cards grouped by a column, a card dragged changing that cell" },
  "words": "kanban renwukanban board 看板 任务 分组 视图 view tasks",
  "parts": {
    "settings": { "at": ":scope > script", "edit": "data" }
  },
  "runtime": { "generated": [":scope > .gallery-kanban-face"] },
  "places": ["document"],
  "settings": [
    { "key": "group", "label": { "zh": "分组依据", "en": "Group by" }, "type": "text", "default": "" },
    { "key": "order", "label": { "zh": "分组的顺序", "en": "Order of the groups" }, "type": "text", "default": "" }
  ],
  "needs": ["tables", "workspace"]
}
