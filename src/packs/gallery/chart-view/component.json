{
  "id": "gallery/chart-view",
  "apiVersion": 1,
  "version": "1.3.0",
  "name": { "zh": "图表", "en": "Chart" },
  "description": { "zh": "表格的视图：按一列分组的计数、合计或平均，或每一行的数，画成条形图，表格一改就重画", "en": "A view of a table: a count, sum or average by a column, or each row's number, drawn as bars that follow each edit of the table" },
  "words": "tubiao tiaoxingtu chart bar bars graph 图表 条形图 柱状图 统计 视图 view",
  "parts": {
    "settings": { "at": ":scope > script", "edit": "data" }
  },
  "runtime": { "generated": [":scope > .gallery-chart-view-face"] },
  "places": ["document"],
  "settings": [
    { "key": "by", "label": { "zh": "分组依据", "en": "Group by" }, "type": "text", "default": "" },
    { "key": "op", "label": { "zh": "计算", "en": "Calculate" }, "type": "select", "options": ["count", "sum", "average"], "default": "count" },
    { "key": "value", "label": { "zh": "数值列", "en": "Numbers" }, "type": "text", "default": "" },
    { "key": "title", "label": { "zh": "标题", "en": "Title" }, "type": "text", "default": "" }
  ],
  "needs": ["tables"]
}
